# Optional. Without a key the pipeline runs fully deterministic (offline demo mode).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai  (auto-detected from whichever key is set)
CERTO_LLM_PROVIDER=
CERTO_LLM_MODEL=
# Optional Postgres + pgvector. Omit for in-memory.
DATABASE_URL=
# curated (seed the 5 hand-verified events) | extract (run Agent A over the seed bulletins at boot)
CERTO_SEED_MODE=curated
CERTO_CORS_ORIGINS=http://localhost:3000
# Frontend -> backend proxy target
CERTO_API_URL=http://localhost:8000
